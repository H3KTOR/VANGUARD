# VANGUARD Toolkit (Python CLI) -- local .env example.
#
# Copy this file to `.env` in the `toolkit/` directory and fill in real
# values. `.env` is a DEV CONVENIENCE ONLY -- it is loaded by
# env_loader.load_dotenv() at the top of main.py, and a real environment
# variable always takes precedence over a value from this file.
#
# In production, prefer a real secrets manager or an inherited shell
# environment over a checked-out `.env` file.
#
# This file is already covered by .gitignore's top-level `.env` pattern --
# never commit your real `.env` with live secrets.

# --- AI forensic analysis (`toolkit analyze`) ------------------------------
# Set ONE of these to enable `toolkit analyze`; provider is auto-detected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults are chosen in ai_analyst.py if unset).
VANGUARD_ANTHROPIC_MODEL=
VANGUARD_OPENAI_MODEL=
