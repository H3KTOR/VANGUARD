# /etc/vanguard/vanguard.env  (mode 0600, owner vanguard)
#
# deploy/install.sh creates this file ONLY if it does not already exist, with a
# freshly generated secret. Never commit a real copy. Upgrades never touch it.

# HMAC key for dashboard sessions. At least 32 random characters; the daemon
# refuses shorter values. Generate with:  openssl rand -hex 32
VANGUARD_JWT_SECRET=

# Addresses Autopilot may never ban (single IPs only; ranges are refused at startup).
# VANGUARD_ADMIN_IPS=203.0.113.10,203.0.113.11

# DNS names the API may be addressed by (IP literals and localhost always work).
# Required when a reverse proxy forwards its public name as Host.
# VANGUARD_ALLOWED_HOSTS=vanguard.example.com

# Optional push alerts (secrets: keep them here, not on the command line).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
