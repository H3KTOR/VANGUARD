# prod
dist/

# dev
.yarn/
!.yarn/releases
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# deps
node_modules/
.wrangler

# env
.env
.env.production
.dev.vars

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# misc
.DS_Store

# --- VANGUARD (Go core) ---
core/vanguard
core/vanguard-*
core/*.db
core/*.db-journal
core/*.db-wal
core/*.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm
core/coverage.out

# --- VANGUARD (Python toolkit) ---
toolkit/__pycache__/
toolkit/*.pyc
toolkit/.venv/
toolkit/venv/
toolkit/*.egg-info/
toolkit/*.pdf

# --- VANGUARD (React frontend) ---
# core/frontend/node_modules and the frontend's own build output are
# covered by the generic node_modules/ and dist/ rules above. The
# Go-embed target directory (core/cmd/vanguard/dist) is likewise a
# `dist/` match and normally ignored -- EXCEPT for a checked-in
# `.gitkeep` placeholder, which must survive so `go build ./...` never
# fails on a fresh checkout before `npm run build` has been run once
# (see cmd/vanguard/frontend.go's go:embed directive).
!core/cmd/vanguard/dist/
core/cmd/vanguard/dist/*
!core/cmd/vanguard/dist/.gitkeep

